---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        <form class="grid gap-4 sm:grid-cols-2 sm:items-end" data-testid="game-filters">
          <label class="flex flex-col gap-2 text-sm text-slate-300">
            <span>Categories</span>
            <select
              multiple
              name="categories"
              class="min-w-48 rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="category-filter"
            >
              {categories.map((category) => (
                <option value={category.id}>{category.name}</option>
              ))}
            </select>
          </label>

          <label class="flex flex-col gap-2 text-sm text-slate-300">
            <span>Publisher</span>
            <select
              name="publisher"
              class="min-w-48 rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </label>

          <button
            type="button"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:border-blue-500 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500 sm:col-span-2 sm:justify-self-end"
            data-testid="clear-filters"
          >
            Clear filters
          </button>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <p class="mb-4 text-sm text-slate-400" data-testid="games-count" aria-live="polite">
            Showing {games.length} games
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => (
              <div
                data-game-category-id={game.category?.id ?? ''}
                data-game-publisher-id={game.publisher?.id ?? ''}
                data-game-card-wrapper
              >
                <GameCard game={game} />
              </div>
            ))}
          </div>
          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const count = document.querySelector<HTMLElement>('[data-testid="games-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-game-card-wrapper]'));

  if (form && categoryFilter && publisherFilter && clearButton && count && emptyState) {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set((params.get('categories') ?? '').split(',').filter(Boolean));
    const selectedPublisher = params.get('publisher') ?? '';

    Array.from(categoryFilter.options).forEach((option) => {
      option.selected = selectedCategories.has(option.value);
    });
    publisherFilter.value = selectedPublisher;

    const applyFilters = (): void => {
      const categories = new Set(selectedCategories);
      const publisher = publisherFilter.value;
      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryId = card.dataset.gameCategoryId ?? '';
        const publisherId = card.dataset.gamePublisherId ?? '';
        const categoryMatches = categories.size === 0 || categories.has(categoryId);
        const publisherMatches = publisher === '' || publisher === publisherId;
        const visible = categoryMatches && publisherMatches;

        card.classList.toggle('hidden', !visible);
        if (visible) visibleCount += 1;
      });

      count.textContent = `Showing ${visibleCount} games`;
      emptyState.classList.toggle('hidden', visibleCount > 0);

      const nextParams = new URLSearchParams();
      if (categories.size > 0) {
        nextParams.set('categories', Array.from(categories).sort().join(','));
      }
      if (publisher !== '') {
        nextParams.set('publisher', publisher);
      }
      const query = nextParams.toString();
      window.history.replaceState({}, '', query ? `${window.location.pathname}?${query}` : window.location.pathname);
    };

    form.addEventListener('change', (event) => {
      if (event.target === categoryFilter) {
        selectedCategories.clear();
        Array.from(categoryFilter.selectedOptions).forEach((option) => selectedCategories.add(option.value));
      }
      applyFilters();
    });
    clearButton.addEventListener('click', () => {
      selectedCategories.clear();
      Array.from(categoryFilter.options).forEach((option) => {
        option.selected = false;
      });
      publisherFilter.value = '';
      applyFilters();
    });
    applyFilters();
  }
</script>
